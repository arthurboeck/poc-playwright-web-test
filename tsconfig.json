{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./tests",
    "paths": {
      "*": ["./node_modules/*"]
    }
  },
  "include": ["tests/**/*"],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
